<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp">
        <shape>
            <solid android:color="#868489" /> <!-- Circle color -->
            <corners android:radius="50dp" /> <!-- Ensures it's a circle -->
            <size
                android:width="40dp"
                android:height="40dp"
                /> <!-- Set the desired size of the circle -->

        </shape>
    </item>
</layer-list>